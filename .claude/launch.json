{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5176"
      ],
      "port": 5176
    },
    {
      "name": "t10-proto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../mdm-t10-proto/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5177"
      ],
      "port": 5177
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "env": {
        "CORS_ORIGINS": "http://localhost:5176,http://127.0.0.1:5176,http://localhost:5173,http://127.0.0.1:5173"
      }
    },
    {
      "name": "api-verify",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "scripts/verification/run_api.py",
        "--port",
        "8000"
      ],
      "port": 8000,
      "env": {
        "CRON_SECRET": "",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
      }
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}