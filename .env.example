# Supabase (local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Database
# The app (API and worker) connects as the restricted app_backend role. Locally
# seed.sql sets its password to app_backend_dev; on hosted, set a generated one
# with ALTER ROLE app_backend PASSWORD '...' and use it here.
DATABASE_URL=postgresql://app_backend:app_backend_dev@127.0.0.1:54322/postgres
# The table owner, for tooling and test fixtures only. Never used by the app.
OWNER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# E-mail (Resend)
RESEND_API_KEY=
MAIL_FROM=alerts@maritime.local
