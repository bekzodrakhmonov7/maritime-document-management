# Supabase (local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Database
# The app connects as the restricted app_backend role. Locally
# seed.sql sets its password to app_backend_dev; on hosted, set a generated one
# with ALTER ROLE app_backend PASSWORD '...' and use it here.
DATABASE_URL=postgresql://app_backend:app_backend_dev@127.0.0.1:54322/postgres
# The table owner, for tooling and test fixtures only. Never used by the app.
OWNER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# E-mail (Resend)
RESEND_API_KEY=
MAIL_FROM=alerts@maritime.local

# Supabase Auth's SMTP password: a Resend API key, used only by
# `supabase config push` for hosted (supabase/config.toml reads it as
# env(SUPABASE_AUTH_SMTP_PASSWORD), with MAIL_FROM as the sender). Leave it empty
# locally: SMTP is off there and Mailpit (http://127.0.0.1:54324) catches the
# sign-in codes. Never commit a value.
SUPABASE_AUTH_SMTP_PASSWORD=

# The daily check. Every 5 minutes the database's `daily-check` pg_cron job
# POSTs to /api/internal/daily-check with this value in X-Cron-Secret (it reads
# it from Vault's `cron_secret`; locally seed.sql sets the same value). Empty
# means the endpoint always answers 404.
CRON_SECRET=local-dev-cron-secret
